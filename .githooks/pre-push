#!/usr/bin/env bash
# Block a push if any commit being pushed contains secrets, per .gitleaks.toml.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "          Install it (https://github.com/gitleaks/gitleaks#installing), then push again." >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"             # new branch: commits not on any remote
  else
    range="$remote_sha..$local_sha"
  fi
  if ! gitleaks detect --no-banner --redact --config .gitleaks.toml --log-opts="$range"; then
    status=1
  fi
done

if [ $status -ne 0 ]; then
  echo "pre-push: secrets found in commits being pushed to $1. Push blocked." >&2
  echo "          Remove them from the commits (amend/rebase), then push again." >&2
fi
exit $status
